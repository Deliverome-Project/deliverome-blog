# Copy to .env (gitignored) and fill in. Never commit .env.
# blog-data reads the nearest .env above the current directory; real
# environment variables take precedence.

# Zenodo personal access token, scopes: deposit:write + deposit:actions.
# Create at https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_TOKEN=

# Optional: separate token from https://sandbox.zenodo.org for rehearsals (--sandbox).
ZENODO_SANDBOX_TOKEN=

# Optional: Zenodo community identifier to request for every data record.
ZENODO_COMMUNITY=
